<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The apps we deep-link into or open. Each package must be listed: since Android 11
         an app can't see (getPackageInfo) packages it doesn't declare here, and the kids'
         screen hides titles whose app it can't see. Keep in step with StreamApp. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.netflix.ninja" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="org.jellyfin.androidtv" />
        <package android:name="com.github.damontecres.wholphin" />
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The watchdog: keeps the kids inside the approved titles. Enabled over ADB
             (`./install.sh`), since Android hides the toggle for sideloaded apps. -->
        <!-- Exported so the system can bind it; BIND_ACCESSIBILITY_SERVICE keeps
             anyone else out (Android's own declaration pattern). -->
        <service
            android:name=".Watchdog"
            android:exported="true"
            android:label="@string/watchdog_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/watchdog" />
        </service>

        <!-- Exists only so the watchdog may read "now playing" (MediaSessionManager). -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="@string/watchdog_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
